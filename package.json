{
  "name": "coincheck-cli",
  "version": "0.1.0",
  "private": false,
  "description": "CLI for the Coincheck API (market data recording, trading)",
  "license": "MIT",
  "bin": {
    "coincheck": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
